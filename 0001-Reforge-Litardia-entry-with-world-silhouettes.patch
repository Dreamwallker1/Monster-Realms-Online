diff --git a/artifacts/monster-realms/src/components/auth/mythora-entry.css b/artifacts/monster-realms/src/components/auth/mythora-entry.css
index 0279e87..72fb6be 100644
--- a/artifacts/monster-realms/src/components/auth/mythora-entry.css
+++ b/artifacts/monster-realms/src/components/auth/mythora-entry.css
@@ -176,3 +176,98 @@
 @media (prefers-reduced-motion: reduce) {
   .mythora-entry * { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
 }
+
+/* ── Litardia world art direction ───────────────────────────────────────── */
+.mythora-entry {
+  --entry-cyan: #63e1ff;
+  --entry-violet: #5876a8;
+  --entry-ember: #ff6a22;
+  background:
+    radial-gradient(circle at 50% 37%, #153746 0, #07141d 27%, transparent 53%),
+    linear-gradient(180deg, #02070a 0, #061017 52%, #020506 100%);
+}
+
+.mythora-nebula {
+  inset: -16%;
+  background:
+    radial-gradient(ellipse at 20% 46%, #0e627054 0, transparent 30%),
+    radial-gradient(ellipse at 80% 42%, #7d2a132b 0, transparent 28%),
+    radial-gradient(ellipse at 50% 84%, #d4471529 0, transparent 30%);
+  filter: blur(38px);
+  opacity: .78;
+}
+
+.mythora-stars { opacity: .12; }
+.mythora-stars-b { opacity: .07; }
+
+.mythora-world { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
+.mythora-moon { position: absolute; top: 7%; left: 50%; width: min(38vw, 540px); aspect-ratio: 1; border-radius: 50%; transform: translateX(-50%); background: radial-gradient(circle, #80e8ff12 0 23%, #3cc8e90c 24% 45%, transparent 68%); box-shadow: 0 0 120px #4bdcff12; }
+.mythora-mountains { position: absolute; left: -6%; width: 112%; background-repeat: repeat-x; }
+.mythora-mountains-far { bottom: 18%; height: 47%; opacity: .58; background: linear-gradient(145deg, transparent 0 43%, #0d2028 43% 57%, transparent 57%) 0 100%/320px 100%, linear-gradient(215deg, transparent 0 45%, #0b1a21 45% 58%, transparent 58%) 140px 100%/360px 90%; filter: drop-shadow(0 -18px 42px #3cd5e20b); }
+.mythora-mountains-near { bottom: 8%; height: 37%; opacity: .95; background: linear-gradient(140deg, transparent 0 45%, #050b0f 45% 64%, transparent 64%) 0 100%/420px 100%, linear-gradient(220deg, transparent 0 43%, #071117 43% 65%, transparent 65%) 210px 100%/440px 88%; }
+.mythora-world-grid { position: absolute; left: -15%; right: -15%; bottom: -12%; height: 42%; opacity: .25; transform: perspective(480px) rotateX(61deg); transform-origin: 50% 100%; background-image: linear-gradient(#33b7cf25 1px, transparent 1px), linear-gradient(90deg, #33b7cf25 1px, transparent 1px); background-size: 72px 44px; mask-image: linear-gradient(to bottom, transparent, #000 60%); }
+.mythora-rift { position: absolute; left: 50%; bottom: -12%; width: 23%; height: 46%; transform: translateX(-50%); clip-path: polygon(48% 0, 58% 18%, 48% 34%, 64% 53%, 52% 68%, 68% 100%, 34% 100%, 47% 70%, 36% 54%, 50% 34%, 42% 18%); background: linear-gradient(90deg, transparent 0, #ff67213a 37%, #ffb45d 49%, #ff5a1f 53%, transparent 100%); filter: blur(1px) drop-shadow(0 0 20px #ff5428a0); opacity: .62; }
+
+.mythora-guardian { position: absolute; z-index: 1; bottom: 2%; width: clamp(310px, 32vw, 610px); pointer-events: none; object-fit: contain; opacity: .27; filter: grayscale(.68) brightness(.42) contrast(1.45) drop-shadow(0 0 38px #000); mask-image: linear-gradient(to bottom, #000 34%, #000 69%, transparent 97%); }
+.mythora-guardian-ashquill { left: -4%; transform: scaleX(-1) rotate(-3deg); transform-origin: 50% 100%; }
+.mythora-guardian-flarelynx { right: -3%; transform: rotate(2deg); transform-origin: 50% 100%; }
+.mythora-guardian-ashquill::after, .mythora-guardian-flarelynx::after { content: ''; }
+
+.mythora-embers { position: absolute; z-index: 2; inset: 0; overflow: hidden; pointer-events: none; }
