diff --git a/artifacts/monster-realms/src/__tests__/SkillCinematic.test.tsx b/artifacts/monster-realms/src/__tests__/SkillCinematic.test.tsx
index a15101c..088a4f9 100644
--- a/artifacts/monster-realms/src/__tests__/SkillCinematic.test.tsx
+++ b/artifacts/monster-realms/src/__tests__/SkillCinematic.test.tsx
@@ -37,4 +37,17 @@ describe('Flarelynx basic attack cinematic', () => {
 
     expect(screen.queryByTestId('flarelynx-target-burn')).not.toBeInTheDocument();
   });
+
+  it('holds the effect during anticipation and releases it only on strike', () => {
+    const props = {
+      skillName: 'Twinflare Claw', element: 'Fire', power: 44,
+      attackerSide: 'player' as const, attackerMythId: 'flarelynx',
+      attackerRarity: 'C', skillType: 'normal', onComplete: vi.fn(),
+    };
+    const { rerender } = render(<SkillCinematic {...props} actionPhase="anticipate" />);
+
+    expect(screen.queryByTestId('flarelynx-fire-claw-wave')).not.toBeInTheDocument();
+    rerender(<SkillCinematic {...props} actionPhase="strike" />);
+    expect(screen.getAllByTestId('flarelynx-fire-claw-wave')).toHaveLength(2);
+  });
 });
