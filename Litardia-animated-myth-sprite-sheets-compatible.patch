diff --git a/artifacts/monster-realms/src/index.css b/artifacts/monster-realms/src/index.css
index bcee0c8..28dad1f 100644
--- a/artifacts/monster-realms/src/index.css
+++ b/artifacts/monster-realms/src/index.css
@@ -705,6 +705,48 @@
     pointer-events: none;
   }
 
+  /* 3x2 authored sprite sheets: idle A, idle B, blink / anticipate, attack, hit */
+  .myth-sheet-sprite {
+    display: block;
+    background-repeat: no-repeat;
+    background-size: 300% 200%;
+    background-position: 0 0;
+    transform-origin: center bottom;
+    user-select: none;
+    pointer-events: none;
+    will-change: background-position, filter;
+    filter: drop-shadow(0 13px 11px rgba(0,0,0,.55));
+  }
+  .myth-sheet-idle {
+    animation: myth-sheet-idle 3.15s step-end infinite;
+  }
+  .myth-sheet-attack {
+    animation: myth-sheet-attack .52s step-end 1, myth-sheet-idle 3.15s step-end .52s infinite;
+  }
+  .myth-sheet-hit {
+    animation: myth-sheet-hit .24s step-end 1, myth-sheet-idle 3.15s step-end .24s infinite;
+  }
+  @keyframes myth-sheet-idle {
+    0%, 36% { background-position: 0 0; }
+    37%, 72% { background-position: 50% 0; }
+    73%, 77% { background-position: 100% 0; }
+    78%, 89% { background-position: 50% 0; }
+    90%, 100% { background-position: 0 0; }
+  }
+  @keyframes myth-sheet-attack {
+    0%, 31% { background-position: 0 100%; }
+    32%, 82% { background-position: 50% 100%; filter: drop-shadow(0 0 18px rgba(255,92,24,.85)); }
+    83%, 100% { background-position: 0 0; }
+  }
+  @keyframes myth-sheet-hit {
+    0%, 76% { background-position: 100% 100%; filter: brightness(1.85) drop-shadow(0 0 20px rgba(255,82,50,.9)); }
+    77%, 100% { background-position: 0 0; filter: drop-shadow(0 13px 11px rgba(0,0,0,.55)); }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .myth-sheet-sprite { animation: none !important; background-position: 0 0; }
+  }
+
   @keyframes battle-entrance {
     0%   { opacity: 0; transform: scale(0.85) translateY(20px); }
     60%  { opacity: 1; transform: scale(1.03) translateY(-3px); }
