diff --git a/artifacts/monster-realms/src/index.css b/artifacts/monster-realms/src/index.css
index 269937e..ca109ea 100644
--- a/artifacts/monster-realms/src/index.css
+++ b/artifacts/monster-realms/src/index.css
@@ -432,6 +432,74 @@
   }
   .battle-idle-bob { animation: battle-idle-bob 2s ease-in-out infinite; }
 
+  .battle-combatant-wild {
+    left: clamp(3%, 8vw, 10%);
+    bottom: 18%;
+  }
+
+  .battle-combatant-player {
+    right: clamp(3%, 8vw, 10%);
+    bottom: 18%;
+  }
+
+  .battle-hit-wild {
+    left: clamp(3%, 8vw, 10%);
+    bottom: 18%;
+  }
+
+  .battle-hit-player {
+    right: clamp(3%, 8vw, 10%);
+    bottom: 18%;
+  }
+
+  .battle-ground-perspective {
+    position: absolute;
+    inset: auto 0 0;
+    height: 38%;
+    z-index: 0;
+    pointer-events: none;
+    background:
+      linear-gradient(to bottom, rgba(255,255,255,0.05), transparent 18%),
+      repeating-linear-gradient(168deg, transparent 0 54px, rgba(255,255,255,0.025) 55px 56px);
+    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent 90%);
+  }
+
+  .battle-stage-pool {
+    position: absolute;
+    width: clamp(210px, 25vw, 430px);
+    height: clamp(42px, 6vw, 82px);
+    bottom: 12%;
+    border-radius: 50%;
+    z-index: 1;
+    opacity: 0.72;
+    pointer-events: none;
+    background: radial-gradient(ellipse, rgba(0,0,0,0.52) 0%, rgba(0,0,0,0.2) 46%, transparent 72%);
+    filter: blur(2px);
+  }
+
+  .battle-stage-pool-wild { left: clamp(0%, 4vw, 6%); }
+  .battle-stage-pool-player { right: clamp(0%, 4vw, 6%); }
+
+  .battle-arena-vignette {
+    position: absolute;
+    inset: 0;
+    z-index: 11;
+    pointer-events: none;
+    background:
+      linear-gradient(to bottom, rgba(2,5,16,0.22), transparent 22%, transparent 76%, rgba(2,5,16,0.18)),
+      radial-gradient(ellipse at center, transparent 45%, rgba(1,3,12,0.3) 100%);
+  }
+
+  @media (max-width: 760px) {
+    .battle-combatant-wild,
+    .battle-hit-wild { left: 1.5%; bottom: 13%; }
+
+    .battle-combatant-player,
+    .battle-hit-player { right: 1.5%; bottom: 13%; }
+
+    .battle-stage-pool { bottom: 8%; width: 46vw; }
+  }
+
   @keyframes flarelynx-battle-breathe {
     0%, 100% { transform: translateY(0) scale(1); filter: drop-shadow(0 10px 10px rgba(0,0,0,0.45)) drop-shadow(0 0 7px rgba(249,72,18,0.35)); }
     50% { transform: translateY(-3px) scale(1.018, 0.992); filter: drop-shadow(0 13px 12px rgba(0,0,0,0.38)) drop-shadow(0 0 13px rgba(255,91,24,0.58)); }
