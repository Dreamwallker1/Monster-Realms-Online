   if (mythId === 'flarelynx') return basic || skillType === 'skill2' || skillType === 'ultimate' ? 'projectile' : 'melee';
-  if (mythId === 'ashquill') return skillType === 'skill1' || skillType === 'skill2' ? 'projectile' : 'melee';
+  if (mythId === 'ashquill') return basic || skillType === 'skill1' || skillType === 'skill2' ? 'projectile' : 'melee';
   return skillType === 'skill2' || skillType === 'ultimate' ? 'projectile' : 'melee';
 }
 
