diff --git a/artifacts/monster-realms/src/components/game/RiggedMythCanvas.tsx b/artifacts/monster-realms/src/components/game/RiggedMythCanvas.tsx
index 9c42669..af26733 100644
--- a/artifacts/monster-realms/src/components/game/RiggedMythCanvas.tsx
+++ b/artifacts/monster-realms/src/components/game/RiggedMythCanvas.tsx
@@ -38,6 +38,25 @@ function getMotion(name: string, t: number, mode: RigMode, myth: string): Motion
     if (name === 'legFront' || name === 'legBack') r = Math.sin(t * 2.3 + (name === 'legBack' ? 1 : 0)) * .025;
   } else if (mode === 'attack') {
     const p = Math.min(t / .9, 1);
+    if (myth === 'ashquill') {
+      // Furnace Gale: grounded inhale, full wing draw, closure, then a second
+      // draw-and-close beat. Talons stay planted while the torso compresses.
+      const firstDraw = Math.sin(Math.min(p / .43, 1) * Math.PI);
+      const secondDraw = p < .45 ? 0 : Math.sin(Math.min((p - .45) / .5, 1) * Math.PI);
+      const draw = Math.max(firstDraw, secondDraw);
+      const close1 = Math.max(0, 1 - Math.abs(p - .40) * 22);
+      const close2 = Math.max(0, 1 - Math.abs(p - .84) * 22);
+      const close = Math.max(close1, close2);
+      const inhale = Math.min(p / .2, 1) * Math.max(0, (1 - p) / .8);
+      if (name === 'body') { y = inhale * -7 + close * 5; sx = 1 + inhale * .035 - close * .025; sy = 1 + inhale * .09 - close * .055; }
+      if (name === 'head') { r = draw * -.08 + close * .16; y = inhale * -3; }
+      if (name === 'wingFront') r = draw * -.72 + close * 1.02;
+      if (name === 'wingBack') r = draw * .62 - close * .88;
+      if (name === 'tail') r = -draw * .16 + close * .24;
+      if (name === 'legFront') { r = close * -.05; sy = 1 + inhale * .025; }
+      if (name === 'legBack') { r = close * .04; sy = 1 + inhale * .025; }
+      return { x, y, r, sx, sy };
+    }
     const wind = p < .42 ? p / .42 : Math.max(0, (1 - p) / .58);
     const hit = Math.max(0, 1 - Math.abs(p - .62) * 7);
     if (name === 'body') { x = hit * 62; y = -hit * 14; r = -hit * .085; sx = 1 + hit * .07; sy = 1 - hit * .04; }
