+// ─── ASHQUILL BASIC: FURNACE GALE ──────────────────────────────────────────
+// Two distinct wing closures. Each pressure disc is born at the wing line,
+// expands as it travels and reaches the defender before the second beat starts.
+function FurnaceGale({ side, color, glow, scale }: {
+  side: 'player' | 'wild'; color: string; glow: string; waves: number; scale: number;
+}) {
+  const { from, to } = sides(side);
+  const dir = side === 'player' ? -1 : 1;
+  return (
+    <>
+      {[0, 1].map((beat) => (
+        <motion.div key={beat} data-testid="ashquill-heat-wave" className="absolute pointer-events-none"
+          style={{ top: `${44 + beat * 3}%`, width: 76 * scale, height: 150 * scale, x: '-50%', y: '-50%', borderRadius: '50%', border: `${Math.max(2, 4 * scale)}px solid ${beat ? '#ffcf88' : color}`, borderLeftColor: 'transparent', borderRightColor: 'transparent', boxShadow: `inset 0 0 22px ${glow},0 0 22px ${glow}`, filter: 'blur(.2px)', zIndex: 3 }}
+          initial={{ left: from, opacity: 0, scaleX: .18, scaleY: .45, rotate: dir * (beat ? -7 : 7) }}
+          animate={{ left: [from,from,to], opacity: [0,.9,.72,0], scaleX: [.18,.55,1.75], scaleY: [.45,1,1.25], rotate: [dir * (beat ? -7 : 7),0] }}
+          transition={{ duration: .62, delay: .12 + beat * .46, times: [0,.18,.82,1], ease: [.2,.72,.18,1] }} />
+      ))}
+      {[0, 1].map((beat) => (
+        <motion.div key={`wing-origin-${beat}`} className="absolute rounded-full pointer-events-none"
+          style={{ left: from, top: '45%', width: 90, height: 90, x: '-50%', y: '-50%', background: `radial-gradient(circle,#fff8d3,${color}77 18%,transparent 67%)`, boxShadow: `0 0 34px ${glow}` }}
+          initial={{ scale: .12, opacity: 0 }} animate={{ scale: [.12,1.05,.2], opacity: [0,.9,0] }}
+          transition={{ duration: .4, delay: beat * .46, ease: 'easeOut' }} />
+      ))}
+    </>
+  );
+}
+
 // ─── Shared geometry helpers ──────────────────────────────────────────────────
 
 // attacker origin X% and defender target X%
@@ -187,7 +214,7 @@ type LimbProfile = { name: string; y: number };
