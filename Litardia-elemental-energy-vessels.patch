From b4d80dc13023158490ca69a687e3878970eb51d2 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 1 Aug 2026 18:37:07 +0100
Subject: [PATCH] Render vitality as elemental energy vessels

---
 .../src/components/game/BattleOverlay.tsx     |  3 ++-
 artifacts/monster-realms/src/index.css        | 26 ++++++++++++++++---
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/artifacts/monster-realms/src/components/game/BattleOverlay.tsx b/artifacts/monster-realms/src/components/game/BattleOverlay.tsx
index f4e5aff..5f5b135 100644
--- a/artifacts/monster-realms/src/components/game/BattleOverlay.tsx
+++ b/artifacts/monster-realms/src/components/game/BattleOverlay.tsx
@@ -761,7 +761,7 @@ function HpPlate({
         <b>VITALITY</b><span>{Math.round(pct)}%</span>
       </div>
       {/* HP bar — numbers live inside the bar */}
-      <div className="battle-hp-meter-wrap">
+      <div className={`battle-hp-meter-wrap battle-hp-meter-${elementKey}`}>
         <div
           className={`relative w-full rounded-full overflow-hidden battle-vital-bar battle-vital-${elementKey}`}
           style={{ background: 'rgba(0,0,0,0.72)', border: '1px solid rgba(255,255,255,0.16)' }}
@@ -776,6 +776,7 @@ function HpPlate({
           >
             <i /><i /><i /><i /><i />
           </div>
+          <div className="battle-hp-glass" aria-hidden="true" />
           {/* HP text overlay */}
           <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
             <span
diff --git a/artifacts/monster-realms/src/index.css b/artifacts/monster-realms/src/index.css
index eed4edf..c980b6e 100644
--- a/artifacts/monster-realms/src/index.css
+++ b/artifacts/monster-realms/src/index.css
@@ -701,8 +701,18 @@
   .battle-hp-badge { height:16px !important; padding:0 5px !important; font:800 7px var(--font-mono,monospace) !important; letter-spacing:.04em; }
   .battle-hp-caption { display:flex; align-items:center; justify-content:space-between; margin:0 2px 4px; color:rgba(255,255,255,.72); font:800 9px var(--font-mono,monospace); letter-spacing:.13em; }
   .battle-hp-caption b { color:#fff; font-size:9px; letter-spacing:.18em; text-shadow:0 0 8px rgba(255,255,255,.25); }
-  .battle-vital-bar { height:30px; box-shadow:inset 0 2px 7px rgba(0,0,0,.8),0 1px 0 rgba(255,255,255,.1),0 0 14px rgba(34,197,94,.1); }
-  .battle-hp-meter-wrap { position:relative; isolation:isolate; }
+  .battle-vital-bar { height:34px; border-radius:9px !important; box-shadow:inset 0 3px 8px rgba(0,0,0,.9),inset 0 -2px 5px rgba(0,0,0,.72),0 1px 0 rgba(255,255,255,.13),0 0 14px rgba(34,197,94,.1); }
+  .battle-hp-meter-wrap { position:relative; isolation:isolate; margin:0 7px 1px; }
+  .battle-hp-meter-wrap::before,
+  .battle-hp-meter-wrap::after {
+    content:""; position:absolute; z-index:7; top:3px; bottom:3px; width:10px; pointer-events:none;
+    border:1px solid rgba(210,224,232,.55);
+    background:linear-gradient(90deg,#202831 0%,#8c9aa5 20%,#e4edf1 46%,#697783 66%,#171e26 100%);
+    box-shadow:inset 0 0 3px rgba(255,255,255,.75),0 2px 5px rgba(0,0,0,.8);
+  }
+  .battle-hp-meter-wrap::before { left:-7px; border-radius:6px 2px 2px 6px; }
+  .battle-hp-meter-wrap::after { right:-7px; border-radius:2px 6px 6px 2px; transform:scaleX(-1); }
+  .battle-hp-glass { position:absolute; z-index:5; inset:2px 3px auto; height:42%; border-radius:8px 8px 45% 45%; pointer-events:none; background:linear-gradient(180deg,rgba(255,255,255,.25),rgba(255,255,255,.055) 55%,transparent); mix-blend-mode:screen; }
   .battle-hp-card-fire { border-color:rgba(251,92,36,.72) !important; box-shadow:0 8px 28px rgba(0,0,0,.82),0 0 18px rgba(249,74,20,.42) !important; }
   .battle-vital-fire { background:linear-gradient(180deg,#211008,#070201) !important; box-shadow:inset 0 2px 8px #000,0 0 14px rgba(255,83,15,.34); }
   .battle-hp-card-water { box-shadow:0 8px 28px rgba(0,0,0,.82),0 0 18px rgba(37,160,255,.32) !important; }
@@ -729,12 +739,22 @@
       radial-gradient(ellipse at 88% 100%,#ffd33d 0 8%,#f13b0b 11% 20%,transparent 23%);
     background-size:34px 31px; animation:battle-fire-hp-flame .72s ease-in-out infinite alternate;
   }
+  .battle-fire-hp-fill::after {
+    content:""; position:absolute; z-index:2; left:-14px; right:-8px; top:50%; height:10px;
+    border-radius:50%; transform:translateY(-50%);
+    background:
+      radial-gradient(ellipse at 12px 50%,#fffbd0 0 2px,#ffd534 3px 5px,transparent 7px) 0 50%/28px 10px repeat-x,
+      linear-gradient(90deg,transparent,#fff4a4 12%,#ffb31a 46%,#fff0a0 72%,transparent);
+    filter:blur(.15px) drop-shadow(0 0 4px #ff8a16);
+    opacity:.76; animation:battle-fire-plasma-current 1.15s linear infinite;
+  }
   .battle-fire-hp-fill > i { position:absolute; z-index:2; bottom:3px; width:3px; height:3px; border-radius:50%; background:#fff2a0; box-shadow:0 0 5px #ff7a17; animation:battle-fire-hp-ember 1.05s ease-out infinite; }
   .battle-fire-hp-fill > i:nth-child(1){left:12%;animation-delay:-.2s}.battle-fire-hp-fill > i:nth-child(2){left:31%;animation-delay:-.75s}.battle-fire-hp-fill > i:nth-child(3){left:52%;animation-delay:-.4s}.battle-fire-hp-fill > i:nth-child(4){left:72%;animation-delay:-.9s}.battle-fire-hp-fill > i:nth-child(5){left:91%;animation-delay:-.55s}
   .battle-fire-ash { position:absolute; z-index:4; top:12px; height:42px; pointer-events:none; overflow:visible; }
   .battle-fire-ash > i { position:absolute; top:0; width:3px; height:3px; border-radius:45% 55% 55% 45%; background:#a69e97; box-shadow:0 0 3px #4b4541; opacity:0; animation:battle-fire-ash-fall 1.45s linear infinite; }
   .battle-fire-ash > i:nth-child(1){left:5%;animation-delay:-.2s}.battle-fire-ash > i:nth-child(2){left:18%;animation-delay:-.85s;width:4px}.battle-fire-ash > i:nth-child(3){left:33%;animation-delay:-1.2s}.battle-fire-ash > i:nth-child(4){left:47%;animation-delay:-.45s;width:2px}.battle-fire-ash > i:nth-child(5){left:61%;animation-delay:-1s}.battle-fire-ash > i:nth-child(6){left:74%;animation-delay:-.65s;width:4px}.battle-fire-ash > i:nth-child(7){left:87%;animation-delay:-1.35s}.battle-fire-ash > i:nth-child(8){left:96%;animation-delay:-.05s;width:2px}
-  @keyframes battle-fire-hp-flame { from{transform:translateY(2px) scaleY(.88);filter:saturate(1)} to{transform:translateY(-1px) scaleY(1.08);filter:saturate(1.2) brightness(1.08)} }
+  @keyframes battle-fire-hp-flame { from{transform:translate(-2px,2px) scaleY(.86);filter:saturate(1)} to{transform:translate(3px,-2px) scaleY(1.11);filter:saturate(1.25) brightness(1.12)} }
+  @keyframes battle-fire-plasma-current { from{background-position:0 50%,0 0} to{background-position:28px 50%,18px 0} }
   @keyframes battle-fire-hp-ember { 0%{opacity:0;transform:translate(0,3px) scale(.5)} 30%{opacity:1} 100%{opacity:0;transform:translate(5px,-18px) scale(.1)} }
   @keyframes battle-fire-ash-fall { 0%{opacity:0;transform:translate(0,-4px) rotate(0)} 18%{opacity:.82} 100%{opacity:0;transform:translate(9px,34px) rotate(190deg)} }
   .battle-water-hp-fill { background:linear-gradient(180deg,#baf3ff 0 8%,#35bdf4 22%,#087bd0 62%,#064480 100%); box-shadow:0 0 7px #73ddff,0 0 15px rgba(24,145,255,.64),inset 0 -6px 9px rgba(2,45,100,.65); }
